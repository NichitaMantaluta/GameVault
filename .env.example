# PostgreSQL (API reads these; Compose maps USERNAME/DATABASE → POSTGRES_USER/POSTGRES_DB)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DATABASE=gamestore
POSTGRES_USERNAME=postgres
POSTGRES_PASSWORD=postgres

# Keycloak container bootstrap admin
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin

# API JWT settings
Authentication__Authority=http://localhost:8080/realms/GameStore
Authentication__Audience=gamestore
Authentication__RequireHttpsMetadata=false

# React (Vite reads this file from the repo root)
VITE_KEYCLOAK_URL=http://localhost:8080
VITE_KEYCLOAK_REALM=GameStore
VITE_KEYCLOAK_CLIENT_ID=gamestore
VITE_API_BASE_URL=http://localhost:5261

# Stripe test mode — replace with your Dashboard + CLI values
Stripe__SecretKey=sk_test_replace_me
Stripe__WebhookSecret=whsec_replace_me
