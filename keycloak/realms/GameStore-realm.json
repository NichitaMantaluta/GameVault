{
  "id": "GameStore",
  "realm": "GameStore",
  "displayName": "GameVault",
  "enabled": true,
  "sslRequired": "none",
  "loginTheme": "gamestore",
  "registrationAllowed": false,
  "resetPasswordAllowed": false,
  "editUsernameAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "accessTokenLifespan": 3600,
  "roles": {
    "realm": [
      {
        "name": "Admin",
        "description": "Can manage the GameVault catalog",
        "composite": false,
        "clientRole": false
      }
    ]
  },
  "groups": [
    {
      "name": "Administrators",
      "path": "/Administrators",
      "realmRoles": [ "Admin" ]
    }
  ],
  "clients": [
    {
      "clientId": "gamestore",
      "name": "GameVault",
      "description": "Public client used to obtain GameVault API access tokens",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "rootUrl": "http://localhost:5173",
      "baseUrl": "http://localhost:5173/",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false,
      "fullScopeAllowed": true,
      "redirectUris": [
        "http://localhost:5173/*",
        "http://localhost:4173/*"
      ],
      "webOrigins": [
        "http://localhost:5173",
        "http://localhost:4173"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "+"
      },
      "defaultClientScopes": [
        "web-origins",
        "acr",
        "profile",
        "roles",
        "email"
      ],
      "optionalClientScopes": [
        "address",
        "phone",
        "offline_access",
        "microprofile-jwt"
      ],
      "protocolMappers": [
        {
          "name": "audience-gamestore",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.custom.audience": "gamestore",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "introspection.token.claim": "true"
          }
        },
        {
          "name": "realm-roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "consentRequired": false,
          "config": {
            "multivalued": "true",
            "claim.name": "role",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "admin",
      "enabled": true,
      "email": "admin@gamestore.local",
      "emailVerified": true,
      "firstName": "Store",
      "lastName": "Admin",
      "credentials": [
        {
          "type": "password",
          "value": "admin",
          "temporary": false
        }
      ],
      "groups": [ "/Administrators" ],
      "realmRoles": [ "Admin", "default-roles-gamestore" ],
      "clientRoles": {
        "account": [ "manage-account", "view-profile" ]
      }
    },
    {
      "username": "customer",
      "enabled": true,
      "email": "customer@gamestore.local",
      "emailVerified": true,
      "firstName": "Store",
      "lastName": "Customer",
      "credentials": [
        {
          "type": "password",
          "value": "customer",
          "temporary": false
        }
      ],
      "realmRoles": [ "default-roles-gamestore" ],
      "clientRoles": {
        "account": [ "manage-account", "view-profile" ]
      }
    }
  ]
}
