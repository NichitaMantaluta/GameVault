@GameStore.Api_HostAddress = http://localhost:5261
@Keycloak_TokenUrl = http://localhost:8080/realms/GameStore/protocol/openid-connect/token

### Get admin access token
# @name adminToken
POST {{Keycloak_TokenUrl}}
Content-Type: application/x-www-form-urlencoded

grant_type=password&client_id=gamestore&username=admin&password=admin

### Get customer access token
# @name customerToken
POST {{Keycloak_TokenUrl}}
Content-Type: application/x-www-form-urlencoded

grant_type=password&client_id=gamestore&username=customer&password=customer

### Create game (admin)
POST {{GameStore.Api_HostAddress}}/api/games
Authorization: Bearer {{adminToken.response.body.access_token}}
Content-Type: application/json

{
  "name": "Super Mario Bros. 3",
  "description": "A classic platform game.",
  "price": 19.99,
  "genreId": 10
}

### Get game
GET {{GameStore.Api_HostAddress}}/api/games/faeaabf8-87a2-4e24-bcee-01b24e6668a1

### Get games
GET {{GameStore.Api_HostAddress}}/api/games?page=1&pageSize=12&search=mario

### Update game (admin)
PUT {{GameStore.Api_HostAddress}}/api/games/faeaabf8-87a2-4e24-bcee-01b24e6668a1
Authorization: Bearer {{adminToken.response.body.access_token}}
Content-Type: application/json

{
  "name": "Celeste",
  "description": "A precise and emotional mountain-climbing platformer.",
  "price": 29.99,
  "genreId": 10,
  "isActive": true
}

### Delete game (admin)
DELETE {{GameStore.Api_HostAddress}}/api/games/faeaabf8-87a2-4e24-bcee-01b24e6668a1
Authorization: Bearer {{adminToken.response.body.access_token}}
